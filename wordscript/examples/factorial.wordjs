let n Equals value OpenParanthesis input OpenParanthesis "n" CloseParanthesis CloseParanthesis SemiColon
let i Equals One SemiColon
let result Equals One SemiColon
while OpenParanthesis i LessThanOrEqual n CloseParanthesis OpenBrace
  result Equals result Multiply i SemiColon
  i PlusEquals One SemiColon
CloseBrace
print OpenParanthesis result CloseParanthesis SemiColon
